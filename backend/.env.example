# Banco de dados (padrão: SQLite local para desenvolvimento)
DATABASE_URL=sqlite:///./confianca.db

# Para produção com PostgreSQL/Supabase, troque por algo como:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco

# Origens permitidas para CORS, separadas por vírgula.
# Use "*" apenas em desenvolvimento — em produção liste o domínio do frontend.
CORS_ORIGINS=*
